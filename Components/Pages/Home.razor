@page "/"

<PageTitle>Sistema de Cupones</PageTitle>

<div class="container mt-5">
    <div class="jumbotron text-center">
        <h1 class="display-4">Sistema de Cupones Promocionales</h1>
        <p class="lead">Plataforma para canje y gestión masiva de cupones</p>
        <hr class="my-4">
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h3>🎫 Canjear Cupón</h3>
                        <p>Ingresa tu código de cupón para obtener tu descuento</p>
                        <a class="btn btn-primary btn-lg" href="/redeem" role="button">Ir a Canjear</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h3>⚙️ Panel Admin</h3>
                        <p>Gestiona campañas y genera cupones masivamente</p>
                        <a class="btn btn-dark btn-lg" href="/admin" role="button">Panel Admin</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
