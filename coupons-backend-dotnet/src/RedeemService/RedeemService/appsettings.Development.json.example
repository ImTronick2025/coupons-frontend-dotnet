{
  "ConnectionStrings": {
    "CouponsDb": "Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=coupons-db;Persist Security Info=False;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
